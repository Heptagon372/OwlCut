# ==== 저장소: Supabase 또는 Firebase 중 하나 ====
# 둘 다 설정하면 Supabase 를 쓴다. 둘 다 없으면 QR·출력·통계만 비활성 (촬영·꾸미기·로컬 저장은 동작).

# ---- Supabase (Phase 4) ----
# 서버 라우트에서만 SERVICE_ROLE_KEY 사용. 절대 클라이언트로 노출 금지.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=photos

# ---- Firebase (Firestore + Cloud Storage) ----
# 서비스 계정 키(JSON 원문 또는 base64 한 줄). 서버에서만 사용, 절대 클라이언트로 노출 금지.
# 만들기: Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성
FIREBASE_SERVICE_ACCOUNT=
# 위 키 대신 GOOGLE_APPLICATION_CREDENTIALS(파일 경로)나 기본 자격증명(Cloud Run 등)도 가능
FIREBASE_PROJECT_ID=
# 사진을 담을 버킷 (예: owlcut.firebasestorage.app). 공개 규칙을 주지 말 것 — 서명 URL 로만 보여 준다.
FIREBASE_STORAGE_BUCKET=

# ==== 사진 보관 · 자동 삭제 ====
# 방문자 사진 보관 시간(시간 단위, 기본 2 = 설계도). 지나면 다운로드 링크가 닫히고 정리 작업이 삭제.
PHOTO_RETENTION_HOURS=2
# /api/cron/cleanup 호출 토큰. GitHub Actions(.github/workflows/cleanup.yml) 또는 Vercel Cron 이 사용.
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ==== 키오스크 ====
# 자리 비움 자동 초기화(초). 비우면 화면별 기본값(촬영 90 · 편집 120 · 결과 60). 값을 넣으면 모든 화면에 적용.
NEXT_PUBLIC_IDLE_SECONDS=

# ==== App ====
# QR에 인코딩되는 다운로드 페이지의 베이스 URL (배포 시 https://photo.sowl.kr 등)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==== 관리자 (Phase 8) ====
# /admin 비밀번호. 비우면 관리자 페이지 비활성. 바꾸면 기존 로그인 세션이 모두 만료됨.
ADMIN_PASSWORD=

# ==== 출력 (Phase 7) ====
# 로컬 프린트 서버(print-server/)와 공유하는 토큰. 비우면 프린트 서버용 API가 전부 401.
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PRINT_SERVER_TOKEN=

# ==== AI (Phase 5) ====
# 키가 있는 프로바이더의 모델만 모델 선택 창에 노출됨. 하나도 없으면 AI 꾸미기 탭은 안내만 표시.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# (선택) OpenAI/Gemini 모델 ID를 배포 시점 최신으로 교체. 비우면 코드 기본값 사용.
OPENAI_MODEL=
GEMINI_MODEL=
