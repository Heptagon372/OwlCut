# 아울네컷 로컬 프린트 서버 설정 — 이 파일을 .env 로 복사해서 사용

# 웹 서버 주소 (배포 시 https://photo.sowl.kr 등)
OWLCUT_API_URL=http://localhost:3000

# 웹 서버의 PRINT_SERVER_TOKEN 과 같은 값 (필수)
PRINT_SERVER_TOKEN=

# 이 프린트 서버의 이름 (관리자 대시보드에 표시). 비우면 booth-<PC이름>
PRINTER_ID=

# OS에 등록된 프린터 이름. 비우면 기본 프린터
SYSTEM_PRINTER=

# 큐 확인 주기 (ms)
POLL_INTERVAL_MS=3000

# 1 이면 실제 출력 대신 print-server/printed/ 폴더에 저장 (프린터 없이 시험용)
PRINT_DRY_RUN=0

# (선택) 출력 명령을 직접 지정. {file} {printer} {copies} 가 치환됨. 경로는 따옴표로 감쌀 것.
# 예) PRINT_COMMAND="C:\Program Files\IrfanView\i_view64.exe" "{file}" /print="{printer}"
PRINT_COMMAND=
